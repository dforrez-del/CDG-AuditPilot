<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CDG.AuditPilot.Desktop.MainWindow" Title="CDG AuditPilot — Cap Digital Gestion" Width="1380" Height="900" MinWidth="1060" MinHeight="720" Background="#EDF2F7" FontFamily="Segoe UI" FontSize="14" Foreground="#10243B" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#102239"><DockPanel Margin="14,24,14,16"><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="8,0,0,20"><Border Background="#10A79F" CornerRadius="13" Width="44" Height="44"><TextBlock Text="AP" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="CDG" FontWeight="Bold" Foreground="White"/><TextBlock Text="AuditPilot" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="Organisation et processus" FontSize="11" Foreground="#9CB4CB"/></StackPanel></StackPanel><Border Background="#1C3048" BorderBrush="#34475E" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,22"><StackPanel><Border Background="White" CornerRadius="7" Padding="8" Width="145" HorizontalAlignment="Left"><Image Source="Assets/Logo.png" Height="42" Stretch="Uniform"/></Border><TextBlock Text="Cap Digital Gestion" Foreground="White" FontWeight="SemiBold" Margin="0,10,0,3"/><TextBlock Text="Vos missions, du diagnostic au suivi" Foreground="#9CB4CB" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Separator Background="#304158" Margin="0,14"/><Button Tag="7" Content="Paramètres et sauvegardes" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Content="Aide et parcours" Click="Help_Click" Style="{StaticResource NavButton}"/><TextBlock Text="Données enregistrées sur ce poste" Foreground="#9CB4CB" FontSize="10" Margin="12,20,0,0"/></StackPanel>
<StackPanel x:Name="Navigation"><Button Tag="6" Content="Tableau de bord" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Tag="0" Content="Clients et missions" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Tag="1" Content="Questionnaires" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Tag="2" Content="Notes d’entretien" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Tag="3" Content="Constats et risques" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Tag="4" Content="Plan d’actions" Click="Navigate_Click" Style="{StaticResource NavButton}"/><Button Tag="5" Content="IA et rapports" Click="Navigate_Click" Style="{StaticResource NavButton}"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
<Border Background="White" BorderBrush="#DCE5EF" BorderThickness="0,0,0,1" Padding="28,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Cap Digital Gestion" FontWeight="SemiBold"/><TextBlock Text="Audit organisationnel · documentaire · stocks · systèmes d’information" Foreground="#64748B" FontSize="11" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#E7F7F4" CornerRadius="16" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="●  Espace local" Foreground="#087F77" FontSize="12"/></Border></Grid></Border>
<Grid Grid.Row="1" Margin="32,24,32,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Mon activité d’audit" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Foreground="#64748B" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Rechercher" Click="Search_Click" VerticalAlignment="Top"/></Grid>
<Border Grid.Row="1" Background="#E4F2F0" BorderBrush="#BBDDD7" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,20,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DOSSIER ACTIF" FontSize="10" FontWeight="SemiBold" Foreground="#087F77"/><TextBlock x:Name="ActiveMission" Text="Choisissez un client puis une mission" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Content="Changer de dossier" Tag="0" Click="Navigate_Click" Background="Transparent" BorderThickness="0"/></Grid></Border>
<WrapPanel Grid.Row="2" x:Name="ContextActions" Margin="0,0,0,12"/>
<TabControl x:Name="Tabs" Grid.Row="3" SelectedIndex="6" Background="Transparent" BorderThickness="0"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template><TabItem Header="Clients et missions">
        <Border Style="{StaticResource Card}"><Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="Nouveau client" FontWeight="Bold"/>
            <TextBox x:Name="ClientName" Margin="0,8" ToolTip="Raison sociale"/>
            <Button Content="Ajouter le client" Click="AddClient_Click"/>
            <ListBox x:Name="ClientsList" Margin="0,12" DisplayMemberPath="Name" SelectionChanged="ClientsList_SelectionChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Nouvelle mission" FontWeight="Bold"/>
            <TextBox x:Name="MissionTitle" Margin="0,8" ToolTip="Intitulé de mission"/>
            <Button Content="Créer la mission pour le client sélectionné" Click="AddMission_Click"/>
            <ListBox x:Name="MissionsList" Margin="0,12" DisplayMemberPath="Title" SelectionChanged="MissionsList_SelectionChanged"/>
          </StackPanel>
        </Grid>
      </Border></TabItem>
      <TabItem Header="Questionnaires">
        <StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Préparez et conduisez votre entretien" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Choisissez un questionnaire dans votre bibliothèque, puis ouvrez l’entretien pour répondre question par question. Les réponses sont conservées avec la mission." TextWrapping="Wrap" Margin="0,10,0,15" Foreground="#64748B"/><Button Content="Ouvrir les entretiens de la mission" Click="OpenInterview_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/></StackPanel></Border><Expander Header="Anciennes listes de questions" Margin="0,16,0,0"><Border Style="{StaticResource Card}"><Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button Content="Importer une ancienne liste de questions" Click="ImportQuestionnaire_Click" Padding="12,6"/>
            <Button Content="Créer questionnaire type" Click="SeedQuestionnaire_Click" Margin="8,0" Padding="12,6"/>
          </StackPanel>
          <DataGrid x:Name="QuestionsGrid" Grid.Row="1" Margin="0,12" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="390" MinHeight="180"><DataGrid.Columns><DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="160"/><DataGridTextColumn Header="Question" Binding="{Binding Text}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/></DataGrid.Columns></DataGrid>
        </Grid>
      </Border></Expander></StackPanel></TabItem>
      <TabItem Header="Entretiens">
        <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Personne interrogée / fonction"/>
            <TextBox x:Name="InterviewPerson" Margin="0,6"/>
            <TextBlock Text="Question et réponse / observations"/>
            <TextBox x:Name="InterviewNotes" AcceptsReturn="True" TextWrapping="Wrap" Height="160" Margin="0,6"/>
            <Button Content="Enregistrer l'entretien" Click="AddInterview_Click"/>
            <DataGrid x:Name="InterviewsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12" MaxHeight="390" MinHeight="180"><DataGrid.Columns><DataGridTextColumn Header="Interlocuteur" Binding="{Binding Person}" Width="180"/><DataGridTextColumn Header="Observations" Binding="{Binding Notes}" Width="*"/><DataGridTextColumn Header="Date" Binding="{Binding CreatedUtc, StringFormat=dd/MM/yyyy}" Width="130"/></DataGrid.Columns></DataGrid>
          </StackPanel>
        </ScrollViewer>
      </Border></TabItem>
      <TabItem Header="Constats et risques">
        <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Constat"/>
            <TextBox x:Name="FindingText" Margin="0,6"/>
            <TextBlock Text="Preuve ou mention 'preuve absente'"/>
            <TextBox x:Name="FindingEvidence" Margin="0,6"/>
            <WrapPanel>
              <TextBlock Text="Impact (1 à 5)" VerticalAlignment="Center"/>
              <TextBox x:Name="Impact" Text="3" Width="40" Margin="8"/>
              <TextBlock Text="Probabilité (1 à 5)" VerticalAlignment="Center"/>
              <TextBox x:Name="Likelihood" Text="3" Width="40" Margin="8"/>
              <Button Content="Ajouter le constat" Click="AddFinding_Click"/>
            </WrapPanel>
            <DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12" MaxHeight="390" MinHeight="180"><DataGrid.Columns><DataGridTextColumn Header="Constat" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Preuve / référence" Binding="{Binding Evidence}" Width="190"/><DataGridTextColumn Header="Impact" Binding="{Binding Impact}" Width="65"/><DataGridTextColumn Header="Probabilité" Binding="{Binding Likelihood}" Width="90"/><DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="65"/><DataGridTextColumn Header="Niveau" Binding="{Binding RiskLevel}" Width="100"/><DataGridCheckBoxColumn Header="Validé" Binding="{Binding Validated}" Width="70"/></DataGrid.Columns></DataGrid>
          </StackPanel>
        </ScrollViewer>
      </Border></TabItem>
      <TabItem Header="Plan d'actions">
        <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Action recommandée"/>
            <TextBox x:Name="ActionText" Margin="0,6"/>
            <TextBlock Text="Responsable"/>
            <TextBox x:Name="ActionOwner" Margin="0,6"/>
            <Button Content="Ajouter l'action" Click="AddAction_Click"/>
            <DataGrid x:Name="ActionsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12" MaxHeight="390" MinHeight="180"><DataGrid.Columns><DataGridTextColumn Header="Action" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Responsable" Binding="{Binding Owner}" Width="150"/><DataGridTextColumn Header="Priorité" Binding="{Binding Priority}" Width="100"/><DataGridTextColumn Header="Échéance" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="110"/><DataGridTextColumn Header="État" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid>
          </StackPanel>
        </ScrollViewer>
      </Border></TabItem>
      <TabItem Header="IA et rapports">
        <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="L'IA nécessite une connexion et un consentement explicite. La clé API est protégée pour votre compte Windows dans les paramètres." TextWrapping="Wrap"/>
            <TextBlock Text="URL de l'API compatible OpenAI (HTTPS)"/>
            <TextBox x:Name="ApiUrl" Text="https://api.openai.com/v1/chat/completions" Margin="0,6"/>
            <TextBlock Text="Modèle"/>
            <TextBox x:Name="ApiModel" Text="gpt-4.1-mini" Margin="0,6"/>
            <CheckBox x:Name="AiConsent" Content="J'autorise l'envoi du texte ci-dessous à ce fournisseur IA" Margin="0,8"/>
            <TextBox x:Name="AiPrompt" Height="110" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,6"/>
            <WrapPanel>
              <Button Content="Analyser avec l'IA" Click="RunAi_Click" Padding="10,5"/>
              <Button Content="Exporter le rapport HTML" Click="ExportReport_Click" Margin="8,0" Padding="10,5"/>
              <Button Content="Exporter les actions CSV" Click="ExportActions_Click" Padding="10,5"/>
              <Button Content="Exporter un schéma SVG" Click="ExportDiagram_Click" Margin="8,0" Padding="10,5"/>
            </WrapPanel>
            <TextBox x:Name="AiResult" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="240" Margin="0,12"/>
          </StackPanel>
        </ScrollViewer>
      </Border></TabItem>
    <TabItem Header="Tableau de bord"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<UniformGrid Columns="3" Margin="0,0,0,10"><Button Tag="0" Click="Navigate_Click" Style="{StaticResource QuickAction}"><StackPanel><TextBlock Text="+  Créer une mission" Foreground="#087F77" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Client, périmètre et objectifs" Foreground="#64748B" FontSize="12" Margin="0,8,0,0"/></StackPanel></Button><Button Click="OpenInterview_Click" Style="{StaticResource QuickAction}"><StackPanel><TextBlock Text="→  Conduire un entretien" Foreground="#087F77" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Questions, réponses et observations" Foreground="#64748B" FontSize="12" Margin="0,8,0,0"/></StackPanel></Button><Button Tag="5" Click="Navigate_Click" Style="{StaticResource QuickAction}"><StackPanel><TextBlock Text="↓  Préparer la restitution" Foreground="#087F77" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Rapport et plan d’actions" Foreground="#64748B" FontSize="12" Margin="0,8,0,0"/></StackPanel></Button></UniformGrid>
<UniformGrid Columns="4" Margin="0,0,0,18"><Border Background="#0C7C76" CornerRadius="12" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="Missions en cours" Foreground="#D7F2EF" FontSize="12"/><TextBlock x:Name="MissionCount" Text="0" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="Tous vos dossiers" Foreground="#C5E8E4" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Clients accompagnés" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="ClientCount" FontSize="30" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="Portefeuille enregistré" Foreground="#64748B" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Constats à revoir" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="ReviewCount" FontSize="30" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="Validation humaine attendue" Foreground="#64748B" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Actions à suivre" Foreground="#64748B" FontSize="12"/><TextBlock x:Name="ActionCount" FontSize="30" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="À planifier ou en cours" Foreground="#64748B" FontSize="11"/></StackPanel></Border></UniformGrid>
<Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Votre parcours d’audit" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Avancez dans votre mission, de la collecte à la restitution." Foreground="#64748B" Margin="0,7,0,16"/><UniformGrid Columns="5"><Button Tag="0" Content="1. Cadrer" Click="Navigate_Click"/><Button Tag="1" Content="2. Interroger" Click="Navigate_Click"/><Button Tag="3" Content="3. Analyser" Click="Navigate_Click"/><Button Tag="4" Content="4. Agir" Click="Navigate_Click"/><Button Tag="5" Content="5. Restituer" Click="Navigate_Click"/></UniformGrid></StackPanel></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,16,0"><StackPanel><TextBlock Text="Vos missions" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="MissionEmpty" Text="Créez votre premier client et sa mission pour commencer." Foreground="#64748B" Margin="0,12" TextWrapping="Wrap"/><ListBox x:Name="RecentMissions" BorderThickness="0" Height="190" MouseDoubleClick="RecentMission_Click"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,9"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Client}" Foreground="#64748B" FontSize="12" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Points d’attention" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="AttentionText" Foreground="#64748B" TextWrapping="Wrap" LineHeight="24" Margin="0,15,0,18"/><ProgressBar x:Name="ReviewProgress" Height="8" Foreground="#0C9188" Background="#E4F2F0" BorderThickness="0"/><TextBlock x:Name="ProgressLabel" Foreground="#087F77" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>
</StackPanel></ScrollViewer></TabItem><TabItem Header="Paramètres"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Votre environnement de travail" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Configurez votre fournisseur IA, personnalisez vos rapports et protégez vos dossiers avec les commandes ci-dessus." TextWrapping="Wrap" Foreground="#64748B" Margin="0,12,0,20"/><TextBlock Text="Sauvegardes et restauration" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Une sauvegarde manuelle protégée par mot de passe peut être conservée sur un autre support. Les sauvegardes automatiques restent liées à ce poste et à votre compte Windows." TextWrapping="Wrap" Foreground="#64748B" Margin="0,10,0,20"/><TextBlock Text="L’IA intervient uniquement après votre autorisation. Les opérations métier restent disponibles hors connexion." TextWrapping="Wrap" Foreground="#087F77"/></StackPanel></Border></TabItem></TabControl>
</Grid><Border Grid.Row="2" BorderBrush="#DCE5EF" BorderThickness="0,1,0,0" Background="White" Padding="28,7"><TextBlock x:Name="StatusText" Text="Prêt · Sélectionnez un dossier pour commencer." Foreground="#64748B" FontSize="11"/></Border></Grid></Grid></Window>
