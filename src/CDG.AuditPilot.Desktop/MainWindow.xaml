<Window x:Class="CDG.AuditPilot.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CDG AuditPilot — Cap Digital Gestion" Height="780" Width="1240" MinWidth="950" MinHeight="620"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><Image Source="Assets/Logo.png" Width="160" Height="45" Stretch="Uniform" HorizontalAlignment="Left"/><TextBlock Text="CDG AuditPilot" FontSize="28" FontWeight="Bold"/><TextBlock Text="Organisation, flux documentaires, stocks et SI — données locales" Margin="0,0,0,12"/></StackPanel><TabControl x:Name="Tabs"><TabItem Header="Clients et missions"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Nouveau client" FontWeight="Bold"/><TextBox x:Name="ClientName" Margin="0,8" ToolTip="Raison sociale"/><Button Content="Ajouter le client" Click="AddClient_Click"/><ListBox x:Name="ClientsList" Margin="0,12" DisplayMemberPath="Name" SelectionChanged="ClientsList_SelectionChanged"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Nouvelle mission" FontWeight="Bold"/><TextBox x:Name="MissionTitle" Margin="0,8" ToolTip="Intitulé de mission"/><Button Content="Créer la mission pour le client sélectionné" Click="AddMission_Click"/><ListBox x:Name="MissionsList" Margin="0,12" DisplayMemberPath="Title" SelectionChanged="MissionsList_SelectionChanged"/></StackPanel></Grid></TabItem><TabItem Header="Questionnaires"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="Importer questionnaire JSON" Click="ImportQuestionnaire_Click" Padding="12,6"/><Button Content="Créer questionnaire type" Click="SeedQuestionnaire_Click" Margin="8,0" Padding="12,6"/></StackPanel><DataGrid x:Name="QuestionsGrid" Grid.Row="1" Margin="0,12" AutoGenerateColumns="True" IsReadOnly="True"/></Grid></TabItem><TabItem Header="Entretiens"><StackPanel Margin="12"><TextBlock Text="Personne interrogée / fonction"/><TextBox x:Name="InterviewPerson" Margin="0,6"/><TextBlock Text="Question et réponse / observations"/><TextBox x:Name="InterviewNotes" AcceptsReturn="True" TextWrapping="Wrap" Height="160" Margin="0,6"/><Button Content="Enregistrer l'entretien" Click="AddInterview_Click"/><DataGrid x:Name="InterviewsGrid" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,12"/></StackPanel></TabItem><TabItem Header="Constats et risques"><StackPanel Margin="12"><TextBlock Text="Constat"/><TextBox x:Name="FindingText" Margin="0,6"/><TextBlock Text="Preuve ou mention 'preuve absente'"/><TextBox x:Name="FindingEvidence" Margin="0,6"/><WrapPanel><TextBlock Text="Impact (1 à 5)" VerticalAlignment="Center"/><TextBox x:Name="Impact" Text="3" Width="40" Margin="8"/><TextBlock Text="Probabilité (1 à 5)" VerticalAlignment="Center"/><TextBox x:Name="Likelihood" Text="3" Width="40" Margin="8"/><Button Content="Ajouter le constat" Click="AddFinding_Click"/></WrapPanel><DataGrid x:Name="FindingsGrid" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,12"/></StackPanel></TabItem><TabItem Header="Plan d'actions"><StackPanel Margin="12"><TextBlock Text="Action recommandée"/><TextBox x:Name="ActionText" Margin="0,6"/><TextBlock Text="Responsable"/><TextBox x:Name="ActionOwner" Margin="0,6"/><Button Content="Ajouter l'action" Click="AddAction_Click"/><DataGrid x:Name="ActionsGrid" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,12"/></StackPanel></TabItem><TabItem Header="IA et rapports"><StackPanel Margin="12"><TextBlock Text="L'IA nécessite une connexion et un consentement explicite. La clé API est protégée pour votre compte Windows dans les paramètres." TextWrapping="Wrap"/><TextBlock Text="URL de l'API compatible OpenAI (HTTPS)"/><TextBox x:Name="ApiUrl" Text="https://api.openai.com/v1/chat/completions" Margin="0,6"/><TextBlock Text="Modèle"/><TextBox x:Name="ApiModel" Text="gpt-4.1-mini" Margin="0,6"/><CheckBox x:Name="AiConsent" Content="J'autorise l'envoi du texte ci-dessous à ce fournisseur IA" Margin="0,8"/><TextBox x:Name="AiPrompt" Height="110" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,6"/><WrapPanel><Button Content="Analyser avec l'IA" Click="RunAi_Click" Padding="10,5"/><Button Content="Exporter le rapport HTML" Click="ExportReport_Click" Margin="8,0" Padding="10,5"/><Button Content="Exporter les actions CSV" Click="ExportActions_Click" Padding="10,5"/><Button Content="Exporter un schéma SVG" Click="ExportDiagram_Click" Margin="8,0" Padding="10,5"/></WrapPanel><TextBox x:Name="AiResult" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="240" Margin="0,12"/></StackPanel></TabItem></TabControl><TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="Sélectionnez un client puis une mission."/></DockPanel></Window>