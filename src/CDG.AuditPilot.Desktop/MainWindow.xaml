<Window x:Class="CDG.AuditPilot.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CDG AuditPilot — Clients et missions" Width="1200" Height="800" MinWidth="950" MinHeight="650" Background="#F3F6FA" WindowStartupLocation="CenterScreen">
<DockPanel>
<Border DockPanel.Dock="Bottom" Background="#E0EDF3" Padding="16,10"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
<Border DockPanel.Dock="Left" Width="210" Background="#0B2742" Padding="18">
<StackPanel><Border Background="White" Padding="8" CornerRadius="8"><Image Source="Assets/Logo.png" Height="125"/></Border>
<TextBlock Text="AuditPilot" Foreground="White" FontSize="25" FontWeight="Bold" Margin="0,20,0,8"/>
<TextBlock Text="Clients et missions" Foreground="#60D4DF" FontSize="17" Margin="0,16"/>
<TextBlock Text="Étape 1 · Socle local" Foreground="White" TextWrapping="Wrap"/>
<TextBlock Text="Conseil organisationnel et digitalisation" Foreground="#B9CADA" Margin="0,24" TextWrapping="Wrap"/>
<TextBlock Text="Aucun envoi cloud. IA non activée." Foreground="#B9CADA" TextWrapping="Wrap"/>
</StackPanel></Border>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26" IsEnabled="{Binding IsIdle}">
<TextBlock Text="Votre espace de travail" FontSize="28" FontWeight="Bold" Foreground="#0B2742"/>
<TextBlock Text="Créez un client, sélectionnez-le, puis préparez sa mission." Margin="0,8,0,20"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
<GroupBox Header="1 · Nouveau client" Padding="14"><StackPanel>
<Label Content="_Raison sociale *" Target="{Binding ElementName=NameInput}"/><TextBox x:Name="NameInput" Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
<Label Content="_E-mail" Target="{Binding ElementName=EmailInput}"/><TextBox x:Name="EmailInput" Text="{Binding ClientEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="254"/>
<Button Content="Enregistrer le _client" Command="{Binding CreateClientCommand}" HorizontalAlignment="Left"/>
</StackPanel></GroupBox>
<GroupBox Grid.Column="2" Header="2 · Client sélectionné" Padding="14"><StackPanel>
<ListBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" DisplayMemberPath="Name" Height="150" AutomationProperties.Name="Clients"/>
<TextBlock Text="{Binding SelectedClient.Email}" Margin="0,10,0,0"/>
</StackPanel></GroupBox></Grid>
<GroupBox Header="3 · Nouvelle mission" Padding="14" Margin="0,20,0,0"><StackPanel>
<TextBlock Text="{Binding SelectedClient.Name, StringFormat=Client : {0}}" FontWeight="Bold"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
<StackPanel><Label Content="Référence unique *"/><TextBox Text="{Binding MissionReference, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Référence de mission"/></StackPanel>
<StackPanel Grid.Column="2"><Label Content="Intitulé *"/><TextBox Text="{Binding MissionTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Intitulé de mission"/></StackPanel></Grid>
<Label Content="Périmètre organisationnel"/><TextBox Text="{Binding MissionScope, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="10000" AutomationProperties.Name="Périmètre"/>
<Button Content="Enregistrer la _mission" Command="{Binding CreateMissionCommand}" HorizontalAlignment="Left"/>
</StackPanel></GroupBox>
<TextBlock Text="Missions du client" FontSize="20" FontWeight="SemiBold" Margin="0,22,0,10"/>
<DataGrid ItemsSource="{Binding Missions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="180" HeadersVisibility="Column">
<DataGrid.Columns><DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="160"/><DataGridTextColumn Header="Intitulé" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="140"/></DataGrid.Columns></DataGrid>
<TextBlock Text="{Binding StoragePath, StringFormat=Dossier local : {0}}" FontSize="11" Foreground="#526576" Margin="0,16" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></DockPanel></Window>
