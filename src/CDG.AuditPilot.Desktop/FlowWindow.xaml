<Window x:Class="CDG.AuditPilot.Desktop.FlowWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Schémas de flux" Width="1150" Height="850" MinWidth="850" MinHeight="650" WindowStartupLocation="CenterOwner">
<DockPanel Margin="16">
<TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8"/>
<StackPanel DockPanel.Dock="Top"><WrapPanel><Button Content="Nouveau" Click="New_Click"/><Button Content="Importer JSON / PNG / JPEG" Click="Import_Click" Margin="8,0"/><Button Content="Générer le schéma" Click="Generate_Click"/><Button Content="Enregistrer dans la mission" Click="Save_Click" Margin="8,0"/><Button Content="Exporter PNG" Click="Export_Click"/></WrapPanel>
<ComboBox x:Name="Saved" SelectionChanged="Saved_Changed" Margin="0,6"/>
<TextBox x:Name="FlowTitle" Text="Nouveau processus" TextChanged="Changed"/>
</StackPanel>
<TabControl>
<TabItem Header="Étapes et liaisons"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<TextBlock Text="Étapes — ajoutez une ligne, indiquez son service ; conservez les identifiants pour relier les étapes." TextWrapping="Wrap"/>
<DataGrid x:Name="NodesGrid" Grid.Row="1" AutoGenerateColumns="False" Margin="0,8" CellEditEnding="GridChanged" PreviewKeyDown="GridKey"><DataGrid.Columns><DataGridTextColumn Header="Identifiant" Binding="{Binding Id}" Width="120"/><DataGridTextColumn Header="Étape" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="220"/></DataGrid.Columns></DataGrid>
<TextBlock Grid.Row="2" Text="Liaisons — utilisez les identifiants des étapes ; libellé possible : facture, validation, Oui, Non…" TextWrapping="Wrap"/>
<DataGrid x:Name="EdgesGrid" Grid.Row="3" AutoGenerateColumns="False" Margin="0,8" CellEditEnding="GridChanged" PreviewKeyDown="GridKey"><DataGrid.Columns><DataGridTextColumn Header="De" Binding="{Binding From}" Width="140"/><DataGridTextColumn Header="Vers" Binding="{Binding To}" Width="140"/><DataGridTextColumn Header="Document / condition" Binding="{Binding Label}" Width="*"/></DataGrid.Columns></DataGrid>
</Grid></TabItem>
<TabItem Header="Schéma"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="Drawing" Background="White" Width="1000" Height="600"/></ScrollViewer></TabItem>
</TabControl></DockPanel></Window>
